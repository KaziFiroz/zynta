# Copy this file to `.env` in the backend/ folder and fill in your own
# values. `.env` is git-ignored and will never be committed.
#
# DATABASE_URL: connection string for your own Postgres instance
# (e.g. from Supabase, Neon, Railway, or a local Postgres install).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Set to "true" only if your provider requires SSL with a self-signed cert
DB_SSL=true

# Generate a real random secret, e.g.: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_secret

PORT=5000

# Optional: protects the one-time /api/seed endpoint. Set this and only
# call /api/seed with a matching key in the request body.
SEED_KEY=choose_your_own_seed_key
